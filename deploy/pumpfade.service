# deploy/install_pumpfade.sh 가 @REPO@ / @USER@ 를 채워 /etc/systemd/system/pumpfade.service 로 설치합니다.
[Unit]
Description=pumpfade paper bot (Binance small-cap pump fade)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv-pumpfade/bin/python -m pumpfade paper
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
