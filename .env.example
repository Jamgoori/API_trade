# .env.example 를 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# paper 모드(모의 거래)와 scan / backtest 에는 아무 키도 필요 없습니다.

# --- Arcus (testnet / live 모드) ---
# app.arcus.xyz/api-keys (테스트넷: testnet.arcus.xyz/api-keys) 에서 만든 "API Signing Key" (개인키, 64자리 hex)
# 키 유효기간은 최대 180일입니다. 만료 전에 새로 발급해 바꾸세요
ARCUS_API_PRIVKEY=
# API 키를 등록한 지갑 주소 (0x...)
ARCUS_ETH_ADDRESS=

# --- Hyperliquid (testnet / live 모드) ---
# 메인 지갑 주소 (잔고와 포지션이 있는 주소)
HL_ACCOUNT_ADDRESS=
# app.hyperliquid.xyz/API 에서 Generate 한 API 지갑의 개인키 (출금 권한 없음). 유효기간은 가장 길게.
# 계정은 Standard 모드여야 합니다 (hedgebot hl-mode 로 확인)
HL_AGENT_PRIVKEY=

# --- 텔레그램 알림 (선택) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
