# .env.example 를 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# paper 모드(모의 거래)와 scan / backtest 에는 아무 키도 필요 없습니다.

# --- Arcus (testnet / live 모드) ---
# app.arcus.xyz/api-keys (테스트넷: testnet.arcus.xyz/api-keys) 에서 만든 "API Signing Key" (개인키, 64자리 hex)
# 키 유효기간은 최대 180일입니다. 만료 전에 새로 발급해 바꾸세요
ARCUS_API_PRIVKEY=
# API 키를 등록한 지갑 주소 (0x...)
ARCUS_ETH_ADDRESS=

# --- Hyperliquid (testnet / live 모드) ---
# 메인 지갑 주소 (잔고와 포지션이 있는 주소)
HL_ACCOUNT_ADDRESS=
# app.hyperliquid.xyz/API 에서 Generate 한 API 지갑의 개인키 (출금 권한 없음). 유효기간은 가장 길게.
# 계정은 Standard 모드여야 합니다 (hedgebot hl-mode 로 확인)
HL_AGENT_PRIVKEY=

# --- Binance 선물 (pumpfade live) ---
# 권한은 '선물 거래'만 켜고, 출금은 끄고, IP 제한(VPS 고정 IP)을 거세요. 이 파일 말고 다른 곳(채팅, 깃허브)에 붙여넣지 마세요
BINANCE_API_KEY=
BINANCE_API_SECRET=
# testnet.binancefuture.com 에서 만든 테스트넷 키 (pumpfade selftest 용, 진짜 돈 아님)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# 신호당 증거금 비율. 처음엔 0.05, 점검을 통과하면 0.12
PUMPFADE_LIVE_MARGIN_FRACTION=0.05

# --- 텔레그램 알림 (선택) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 봇이 살아 있는지 감시 (선택) ---
# healthchecks.io 체크의 Ping URL (https://hc-ping.com/...). 봇이 5분마다 신호를 보내고, 끊기면 healthchecks 가 알려줘요
PUMPFADE_HEARTBEAT_URL=
